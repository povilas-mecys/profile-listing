{#
/**
 * @file
 * Default theme implementation to display a paragraph.
 *
 * Available variables:
 * - paragraph: Full paragraph entity.
 *   Only method names starting with "get", "has", or "is" and a few common
 *   methods such as "id", "label", and "bundle" are available. For example:
 *   - paragraph.getCreatedTime() will return the paragraph creation timestamp.
 *   - paragraph.id(): The paragraph ID.
 *   - paragraph.bundle(): The type of the paragraph, for example, "image" or "text".
 *   - paragraph.getOwnerId(): The user ID of the paragraph author.
 *   See Drupal\paragraphs\Entity\Paragraph for a full list of public properties
 *   and methods for the paragraph object.
 * - content: All paragraph items. Use {{ content }} to print them all,
 *   or print a subset such as {{ content.field_example }}. Use
 *   {{ content|without('field_example') }} to temporarily suppress the printing
 *   of a given child element.
 * - attributes: HTML attributes for the containing element.
 *   The attributes.class element may contain one or more of the following
 *   classes:
 *   - paragraphs: The current template type (also known as a "theming hook").
 *   - paragraphs--type-[type]: The current paragraphs type. For example, if the paragraph is an
 *     "Image" it would result in "paragraphs--type--image". Note that the machine
 *     name will often be in a short form of the human readable label.
 *   - paragraphs--view-mode--[view_mode]: The View Mode of the paragraph; for example, a
 *     preview would result in: "paragraphs--view-mode--preview", and
 *     default: "paragraphs--view-mode--default".
 * - view_mode: View mode; for example, "preview" or "full".
 * - logged_in: Flag for authenticated user status. Will be true when the
 *   current user is a logged-in member.
 * - is_admin: Flag for admin user status. Will be true when the current user
 *   is an administrator.
 *
 * @see template_preprocess_paragraph()
 *
 * @ingroup themeable
 */
#}

{% import "@brown/partials/macros.twig" as site %}
{% set id = paragraph.id() %}

 

{% set listing_layout = layout|default('grid') in ['grid', 'list'] ? layout|default('grid') : 'grid' %}
{% set listing_heading_level = heading_level|default(2) in [2, 3, 4, 5] ? heading_level|default(2) : 2 %}
{% set listing_title = title|default('') %}
{% set listing_caption = caption|default('') %}
{% set listing_profiles = profiles|default([]) %}
{% set profile_heading_level = listing_title ? listing_heading_level + 1 : listing_heading_level %}






{% if listing_profiles %}
  {% set listing_attributes = attributes|default(create_attribute()) %}
  {% set listing_classes = [
    'profile_listing',
    'profile_listing_' ~ listing_layout,
    'component-item',
  ] %}

  <section{{ listing_attributes.addClass(listing_classes) }}>
    {% if listing_title or listing_caption %}
      <header class="profile_listing_header">
        {% if listing_title %}
          <h{{ listing_heading_level }} class="profile_listing_title">{{ listing_title }}</h{{ listing_heading_level }}>
        {% endif %}

        {% if listing_caption %}
          <p class="profile_listing_caption">{{ listing_caption }}</p>
        {% endif %}
      </header>
    {% endif %}

    <ul class="profile_listing_items">
      {% for profile in listing_profiles %}
        {% set profile_url = profile.url|default('') %}

        <li class="profile_listing_item">
          {% if profile.image.src|default('') %}
            {% set media_attributes = create_attribute({ class: ['profile_listing_media'] }) %}
            {% set media_tag = profile_url ? 'a' : 'div' %}
            {% if profile_url %}
              {% set media_attributes = media_attributes
                .setAttribute('href', profile_url)
                .setAttribute('tabindex', '-1')
                .setAttribute('aria-hidden', 'true')
              %}
            {% endif %}

            {% set image_attributes = create_attribute({
              class: ['profile_listing_image'],
              src: profile.image.src,
              alt: '',
              loading: 'lazy',
              decoding: 'async',
            }) %}
            {% if profile.image.width|default(0) > 0 and profile.image.height|default(0) > 0 %}
              {% set image_attributes = image_attributes
                .setAttribute('width', profile.image.width)
                .setAttribute('height', profile.image.height)
              %}
            {% endif %}

            <{{ media_tag }}{{ media_attributes }}>
              <img{{ image_attributes }}>
            </{{ media_tag }}>
          {% endif %}

          <div class="profile_listing_info">
            {% if profile.eyebrow|default('') %}
              <p class="profile_listing_eyebrow">{{ profile.eyebrow }}</p>
            {% endif %}

            <h{{ profile_heading_level }} class="profile_listing_name">
              {% if profile_url %}
                <a class="profile_listing_link" href="{{ profile_url }}">{{ profile.name }}</a>
              {% else %}
                {{ profile.name }}
              {% endif %}
            </h{{ profile_heading_level }}>

            {% if profile.role|default('') %}
              <p class="profile_listing_role">{{ profile.role }}</p>
            {% endif %}

            {% if profile.focus|default('') %}
              <p class="profile_listing_focus">{{ 'Research focus: @focus'|t({ '@focus': profile.focus }) }}</p>
            {% endif %}
          </div>
        </li>
      {% endfor %}
    </ul>
  </section>
{% endif %}
